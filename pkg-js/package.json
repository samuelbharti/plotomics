{
  "name": "plotomics",
  "version": "0.1.0",
  "description": "High-performance bioinformatics visualization components: headless factories for volcano plots, heatmaps, embeddings, oncoprints, genome browsers and more, backed by a shared TypeScript core.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelbharti/plotomics.git",
    "directory": "pkg-js"
  },
  "homepage": "https://github.com/samuelbharti/plotomics#readme",
  "bugs": "https://github.com/samuelbharti/plotomics/issues",
  "main": "./dist/lib/lib/index.js",
  "types": "./dist/lib/lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/lib/lib/index.d.ts",
      "import": "./dist/lib/lib/index.js"
    },
    "./core": {
      "types": "./dist/lib/core/index.d.ts",
      "import": "./dist/lib/core/index.js"
    },
    "./clustermap": {
      "types": "./dist/lib/components/clustermap.d.ts",
      "import": "./dist/lib/components/clustermap.js"
    },
    "./embedding": {
      "types": "./dist/lib/components/embedding.d.ts",
      "import": "./dist/lib/components/embedding.js"
    },
    "./gosling": {
      "types": "./dist/lib/components/gosling.d.ts",
      "import": "./dist/lib/components/gosling.js"
    },
    "./heatmap": {
      "types": "./dist/lib/components/heatmap.d.ts",
      "import": "./dist/lib/components/heatmap.js"
    },
    "./hic": {
      "types": "./dist/lib/components/hic.d.ts",
      "import": "./dist/lib/components/hic.js"
    },
    "./igv": {
      "types": "./dist/lib/components/igv.d.ts",
      "import": "./dist/lib/components/igv.js"
    },
    "./dotplot": {
      "types": "./dist/lib/components/dotplot.d.ts",
      "import": "./dist/lib/components/dotplot.js"
    },
    "./km": {
      "types": "./dist/lib/components/km.d.ts",
      "import": "./dist/lib/components/km.js"
    },
    "./lollipop": {
      "types": "./dist/lib/components/lollipop.d.ts",
      "import": "./dist/lib/components/lollipop.js"
    },
    "./network": {
      "types": "./dist/lib/components/network.d.ts",
      "import": "./dist/lib/components/network.js"
    },
    "./oncoplot": {
      "types": "./dist/lib/components/oncoplot.d.ts",
      "import": "./dist/lib/components/oncoplot.js"
    },
    "./profile": {
      "types": "./dist/lib/components/profile.d.ts",
      "import": "./dist/lib/components/profile.js"
    },
    "./spatial": {
      "types": "./dist/lib/components/spatial.d.ts",
      "import": "./dist/lib/components/spatial.js"
    },
    "./treemap": {
      "types": "./dist/lib/components/treemap.d.ts",
      "import": "./dist/lib/components/treemap.js"
    },
    "./upset": {
      "types": "./dist/lib/components/upset.d.ts",
      "import": "./dist/lib/components/upset.js"
    },
    "./violin": {
      "types": "./dist/lib/components/violin.d.ts",
      "import": "./dist/lib/components/violin.js"
    },
    "./volcano": {
      "types": "./dist/lib/components/volcano.d.ts",
      "import": "./dist/lib/components/volcano.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "ml-hclust": "^4.0.0",
    "regl": "^2.1.1",
    "regl-scatterplot": "^1.16.0"
  },
  "peerDependencies": {
    "gosling.js": "^1.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.0",
    "igv": "^3.0.0",
    "pixi.js": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sigma": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "gosling.js": {
      "optional": true
    },
    "graphology": {
      "optional": true
    },
    "graphology-layout-forceatlas2": {
      "optional": true
    },
    "igv": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sigma": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "esbuild": "^0.28.2",
    "gosling.js": "^1.0.7",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "igv": "^3.8.5",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sigma": "^3.0.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "bioinformatics",
    "visualization",
    "genomics",
    "single-cell",
    "webgl",
    "canvas",
    "heatmap",
    "volcano-plot",
    "oncoprint"
  ]
}
