{
  "name": "@bioviz/core",
  "version": "0.1.0",
  "description": "Shared contract, theming, color scales, binary transport and export helpers for bioviz components.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelbharti/visualization-components.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/samuelbharti/visualization-components#readme",
  "bugs": "https://github.com/samuelbharti/visualization-components/issues",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
