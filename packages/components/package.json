{
  "name": "@bioviz/components",
  "version": "0.1.0",
  "description": "Headless, high-performance bioinformatics visualization components.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelbharti/visualization-components.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/samuelbharti/visualization-components#readme",
  "bugs": "https://github.com/samuelbharti/visualization-components/issues",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bioviz/core": "workspace:*",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "gosling.js": "^1.0.7",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "igv": "^3.8.3",
    "ml-hclust": "^4.0.0",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "regl": "^2.1.1",
    "regl-scatterplot": "^1.16.0",
    "sigma": "^3.0.3"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
