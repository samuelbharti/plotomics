{
  "name": "bioviz-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight, high-performance bioinformatics visualization components with R and Python wrappers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "sync": "node scripts/sync-assets.mjs",
    "dist": "pnpm build && pnpm sync",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "lint": "pnpm -r --filter \"./packages/**\" lint",
    "dev": "pnpm --filter @bioviz/components dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
